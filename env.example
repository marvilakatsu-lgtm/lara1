# Copie este arquivo para .env. Nunca publique o .env nem envie tokens em tickets/logs.
# Segredos e configuração de infraestrutura ficam aqui; canais/cargos operacionais são escolhidos em /adm.
DISCORD_TOKEN=

# Persistência. Antes de substituir um bot em produção, copie os bancos existentes para estes caminhos.
DATA_DIR=data
DB_PATH=data/colizeu.db
CATALOGO_DATA_DIR=data
CATALOGO_DB_PATH=data/jogos.db

# Integrações externas (opcionais; mantenha vazias se não forem usadas).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCBuR1KPa9g9yYilBiy_7iqw
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# IDs legados são opcionais e servem apenas para migração inicial para /adm.
# Deixe vazios quando o painel já estiver configurado; valores válidos são importados por servidor.
GUILD_ID=
MOD_CHANNEL_ID=
PLATINAS_CHANNEL_ID=
COLIZEU_CHANNEL_ID=
MOD_ROLE_ID=
PERFIS_CHANNEL_ID=
CREATOR_VIDEO_CHANNEL_ID=
CREATOR_LIVE_CHANNEL_ID=
GAMES_CHANNEL_ID=
PROMOS_CHANNEL_ID=
SOULSLIKE_CHANNEL_ID=
ZERADOS_CHANNEL_ID=

# Identidade opcional do dono (exibe redes pessoais no santuário, se configuradas no módulo).
DONO_ID=

# Nexus IA (Gemini)
IA_LIMITE_DIARIO=10
# IDs de canais onde a IA responde sem menção. Vazio = apenas quando marcada.
IA_CANAIS_LIVRES=
IA_TETO_ESPONTANEO=40
IA_COOLDOWN_CANAL=45

# Agendamento/filtros; ajuste segundo a cota das APIs e o ritmo do servidor.
YOUTUBE_VIDEO_CHECK_SECONDS=120
YOUTUBE_LIVE_CHECK_MINUTES=10
OFFERS_CHECK_MINUTES=30
MAX_OFFERS_PER_CHECK=8
MIN_PROMO_DISCOUNT=20
SEED_OFFERS_ON_FIRST_RUN=true
# Fontes de ofertas habilitadas (separadas por vírgula). Opções: Steam, GamerPower, Epic Games Store, GOG
OFFERS_ENABLED_SOURCES=Steam,GamerPower,Epic Games Store,GOG

# Jogos zerados
XP_ZERADO=50
DENARIOS_ZERADO=10
ZERADOS_XP_LIMITE_DIARIO=3

# Nome visual dos cargos de notificação (não são IDs nem concedem permissões).
ROLE_VIDEO_NAME=🔔 Avisos de Vídeo
ROLE_LIVE_NAME=🔴 Avisos de Live
